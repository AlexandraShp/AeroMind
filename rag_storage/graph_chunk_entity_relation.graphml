    <node id="Hydraulic System">
      <data key="d0">Hydraulic System</data>
      <data key="d1">method</data>
      <data key="d2">A system used in the Airbus A320 aircraft to provide power to critical aircraft components, operating through hydraulic pressure.</data>
      <data key="d3">doc-6e35aaeeac2f9cad484f2cb6c81c8142-chunk-000</data>
      <data key="d4">unknown_source</data>
