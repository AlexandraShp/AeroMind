    <node id="Airbus A320">
      <data key="d0">Airbus A320</data>
      <data key="d1">artifact</data>
      <data key="d2">The Airbus A320 is an aircraft that utilizes hydraulic systems to power various important aircraft systems.</data>
      <data key="d3">doc-6e35aaeeac2f9cad484f2cb6c81c8142-chunk-000</data>
      <data key="d4">unknown_source</data>
