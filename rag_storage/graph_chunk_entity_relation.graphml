    <node id="Aircraft System">
      <data key="d0">Aircraft System</data>
      <data key="d1">concept</data>
      <data key="d2">Various functions and components within an aircraft that require power for operation.</data>
      <data key="d3">doc-6e35aaeeac2f9cad484f2cb6c81c8142-chunk-000</data>
      <data key="d4">unknown_source</data>
